{
  "name": "confy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @confy/shared build",
    "dev": "pnpm build:shared && pnpm --parallel --filter \"./apps/*\" dev",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm build:shared && pnpm -r test"
  }
}
