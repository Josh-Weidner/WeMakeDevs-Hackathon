# Copy to .env and fill in. .env is gitignored. In k8s it becomes the `confy-secrets` Secret (make secrets).

# Elastic Cloud Serverless (Elasticsearch project): endpoint URL + API key
ELASTICSEARCH_URL=https://<project>.es.<region>.elastic.cloud:443
ELASTICSEARCH_API_KEY=

# OpenAI (embeddings, chat, speech-to-text)
OPENAI_API_KEY=

# Dash0 OTLP export. Find the endpoint + auth token in Dash0 → Settings → Endpoints / Auth Tokens
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingress.<region>.aws.dash0.com
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <dash0-auth-token>
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Local dev only (k8s sets these via ConfigMap)
API_BASE_URL=http://localhost:4000
