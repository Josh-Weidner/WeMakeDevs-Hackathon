{
  "name": "@confy/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./telemetry/register": {
      "types": "./dist/telemetry/register.d.ts",
      "default": "./dist/telemetry/register.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.5.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.301.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.301.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.1",
    "@opentelemetry/instrumentation": "^0.301.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "openai": "^7.54.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  }
}
